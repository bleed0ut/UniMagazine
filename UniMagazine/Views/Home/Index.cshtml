@model MagazineFilterVM

@{
    ViewData["Title"] = "Home Page";
}

<div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div id="bannerImg" class="carousel-item active">
            <img src="./img/Banner/mainBanner.jpg" class="d-block w-100 h-100 opacity-75" style="max-height: 420px; object-fit: cover" alt="...">
        </div>
    </div>
</div>

<div id="main-anounment" class="">
    <div id="anounment-tag">
        ANOUCEMENT HI
    </div>
    <p id="anounment-text">
        Wisdom is not a product of school, but a lifelong learning process
    </p>
</div>

<div id="main-control">
    <div class="main-control-left">
         <form asp-action="Index" class="d-flex" method="get">
            <p><button type="submit" id="status" name="status" value="Opening" class="main-control-text">Current Topic</button></p>
            <p><button type="submit" id="status" name="status" value="Closed" class="main-control-text">End Topic</button></p>

            @if (Model.Status == "Closed")
            {
                <div class="" style="margin-right: 10px">
                    <label class="visually-hidden" for="acaYearId"></label>
                    <select class="form-select" id="academicYearId" name="academicYearId">
                        <option selected disabled>Academic Years</option>
                        @foreach (var acaYear in Model.AcademicYearsDisplay)
                        {
                            <option selected="@(acaYear.Id == Model.AcademicYearId)" value="@acaYear.Id">@acaYear.YearDate.ToString("yyyy")</option>
                        }
                    </select>
                </div>
            }
            @if (string.IsNullOrEmpty(ViewBag.UserId))
            {
                <div class="" style="margin-right: 10px">
                    <label class="visually-hidden" for="facultyId"></label>
                    <select class="form-select" id="facultyId" name="facultyId">
                        <option selected disabled>Faculties</option>
                        @foreach (var faculty in Model.FacultiesDisplay)
                        {
                            <option selected="@(faculty.Id == Model.FacultyId)" value="@faculty.Id">@faculty.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="" style="margin-right: 10px">
                <label class="visually-hidden" for="search"></label>
                <div class="input-group">
                    <div class="input-group-text"></div>
                    <input type="text" class="form-control" value="@Model.Search" id="search" name="search" placeholder="Search by title">
                    <input type="text" value = "@Model.Status" id="status" name="status" hidden/>
                </div>
            </div>
            <div class="" style="margin-right: 10px">
                <button type="submit" class="btn btn-light" id ="status" value="@Model.Status">Search</button>
                <a href="/Home/Index" class="btn btn-danger">Clear</a>
            </div>
        </form>
    </div>
    <div class="main-control-text-right">
        <a>
            <i class="fa-solid fa-list"></i>
        </a>
    </div>
</div>

@* MAGAZINES *@
<div class="row">
    @foreach(var mag in Model.Magazines)
    {
        <div class="col-sm-10 col-md-6 col-lg-4 mb-3">
            <a style="text-decoration: none; color: black" asp-route-id="@mag.Id" asp-controller="Home" asp-action="MagazineDetail">
                <div class="card shadow" style="max-width: 438px; min-height: 520px">
                    <img src="@mag.ImageUrl" class="card-img-top" style="max-height: 210px; object-fit: cover" alt="...">
                    <div class="card-body">
                        <p class="card-title" style="font-size: 18px; font-weight: bold; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden">@mag.Title</p>
                        <p class="card-text" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden">@mag.Detail</p>
                    </div>
                    <div class="card-footer">
                        <p class="my-0 fw-light">
                            <span style="font-weight: bold">Status: </span>
                            @if (@mag.Status == "Not Started")
                            {
                                <span class="badge bg-secondary">@mag.Status</span>
                            }
                            else if (@mag.Status == "Opening")
                            {
                                <span class="d-inline-block badge bg-success">@mag.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@mag.Status</span>
                            }
                        </p>
                    </div>
                    <div class="card-footer">
                        <p class="my-0 fw-light"><span style="font-weight: bold">Falcuty: </span>@mag.Faculty.Name</p>
                    </div>
                    <div class="card-footer">
                        <p class="my-0 fw-light"><span style="font-weight: bold">Open Date: </span>@mag.OpenedDate</p>
                        <p class="my-0 fw-light"><span style="font-weight: bold">Closed Date: </span>@mag.ClosedDate</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

