@using Microsoft.AspNetCore.Identity
@using UniMagazine.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniMagazine</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniMagazine.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
</head>
<body class="">
    <nav class="navbar mb-3" style="background-color: var(--primary-color); height: 80px">
        <div class="container h-100" style="">
            <a class="navbar-brand h-75" asp-area="" asp-controller="Home" asp-action="Index">
                <h3 class="text-white">UniMagazine</h3>
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                <i id="nav-bar-toggle" class="fa-solid fa-bars" style="color: white; font-size: 25px; cursor: pointer"></i>
            }else{
                <a class="nav-link btn btn-light text-black" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
            }
        </div>
    </nav>
    <div id="nav-bar-side">
        <partial name="_LoginPartial.cshtml" />
    </div>


    <main class="container">
        <div role="main" class="pb-3 position-relative">
            @RenderBody()
        </div>
@*         <div>
            <partial name="_Notification" />
        </div> *@
    </main>

    <footer class="text-muted" style="background-color: var(--primary-color)">
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-4">
                <h4>ABOUT</h4>
                <p style="text-align: justify;">
                    Welcome to our student-centric platform dedicated to fostering creativity, expression, and collaboration.
                    Here, students from diverse backgrounds converge to contribute their unique perspectives, stories, and
                    talents to our vibrant magazine.
                </p>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-4">
                <h4>CATEGORIES</h4>
                <ul class="footer--list">
                    <li class="">Current Topics</li>
                    <li class="">Ended Topics</li>
                </ul>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-4">
                <h4>QUICK LINK</h4>
                <ul class="footer--list">
                    <li>About Us</li>
                    <li>Contact Us</li>
                    <li>Contribute</li>
                    <li>Privacy Policy</li>
                    <li>Sitemap</li>
                </ul>
            </div>
        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
