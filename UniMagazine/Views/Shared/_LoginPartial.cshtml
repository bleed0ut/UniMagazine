@using Microsoft.AspNetCore.Identity
@using UniMagazine.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<div class="header__nav">
    <div class="d-flex position-relative w-100">
        <div class="header__nav--heading">MENU</div>
        <i id="header__nav--close-icon" class="fa-solid fa-xmark" style="color: #ffffff;"></i>
    </div>
    <div class="header__nav--email">Email: 
        <span>@UserManager.GetUserName(User)</span>
    </div>
    <div class="w-100 text-center">
        @if (User.IsInRole("Admin"))
        {
            <p class="header__nav--role-admin">ADMIN</p>
            <hr class="bg-white"/>
            <a class="header__nav--role-function" asp-area="Admin" asp-controller="User" asp-action="UserIndex">
                <div class="header__nav--role-hover">
                    Admin Management Page
                     </div>
            </a>
        }
        @if (User.IsInRole("Manager"))
        {
            <p class="header__nav--role">MANAGER</p>
            <hr class="bg-white" />
            <a class="header__nav--role-function" asp-area="Manager" asp-controller="Magazine" asp-action="Index">
                <div class="header__nav--role-hover">
                    Manager anagement Page
                </div>
            </a>
        }
        @if (User.IsInRole("Coordinator"))
        {
            <p class="header__nav--role">Coordinator</p>
            <hr class="bg-white" />
            <a class="header__nav--role-function" asp-area="Coordinator" asp-controller="Contribution" asp-action="ContributionModeration">
                <div class="header__nav--role-hover">
                    Coordinator anagement Page
                </div>
            </a>
        }
        @if (User.IsInRole("Student"))
        {
            <p class="header__nav--role">Student</p>
            <hr class="bg-white" />
            <a class="header__nav--role-function" asp-area="Student" asp-controller="Contribution" asp-action="MyContribution">
                <div class="header__nav--role-hover">
                    My Submission
                </div>
            </a>
        }
    </div>
    <div class="w-100">
        <hr class="bg-white" />
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button class="header__nav--logout" href="#" id="logout" type="submit">Logout</button>
        </form>
    </div>
</div>
