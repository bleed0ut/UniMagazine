@using Microsoft.AspNetCore.Identity
@using UniMagazine.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<ul style="list-style-type: none; padding: 0; margin: 0">
@if (SignInManager.IsSignedIn(User))
{
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white px-0 " href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-user-tie pe-2"></i>@UserManager.GetUserName(User)!
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                <li><a class="dropdown-item nav-link text-black" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Profile</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button class="dropdown-item nav-link btn btn-link text-danger border-0" href="#" id="logout" type="submit">Logout</button>
                    </form>
                </li>
            </ul>
        </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link btn btn-light text-black" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
