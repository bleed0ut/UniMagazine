@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="text-center">
    <img src="~/img/icon/login-icon.png" class="" style="width: 20%; filter: brightness(0) invert(1);" />
</div>
<div class="d-flex flex-direction-row align-items-center mb-4">
    <hr class="flex-fill"/>
    <h1 class="mx-5">@ViewData["Title"]</h1>
    <hr class="flex-fill"/>
</div>

<form id="account" method="post" class="text-black">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" style="outline: none;" />
        <label asp-for="Input.Email" class="form-label">Email</label>
        <span asp-validation-for="Input.Email" class="text-white"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.Password" class="form-label">Password</label>
        <span asp-validation-for="Input.Password" class="text-white"></span>
    </div>
    <div class="checkbox mb-3 text-white">
        <label asp-for="Input.RememberMe" class="form-label">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            @Html.DisplayNameFor(m => m.Input.RememberMe)
        </label>
    </div>
    <div>
        <button id="login-submit" type="submit" class="w-100 btn btn-lg text-black" style="background-color: white;">Log in</button>
    </div>
    <div>
        <p>
            <a id="forgot-password" asp-page="./ForgotPassword" class="text-white">Forgot your password?</a>
        </p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
