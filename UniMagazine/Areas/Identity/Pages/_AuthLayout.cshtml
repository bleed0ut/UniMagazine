@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row justify-content-center">
    <div class="col-5 mt-5">
        @* Bọc chứa login *@
        <div class="card login-logout-card" style="background-color: #7077A1; background: linear-gradient(to bottom, #0f2027, #424769, #7077A1);">
            <div class="card-body">
                <div class="row justify-content-center">
                    <div class="row justify-content-center">
                        <div class="col-10 mt-4 text-white">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(function () {
            const currentPage = location.pathname;
            $('.nav-tabs li a').each(function () {
                const $this = $(this);
                if (currentPage.toLowerCase().indexOf($this.attr('href').toLowerCase()) !== -1) {
                    $this.addClass('active');
                }
            })
        })
    </script>
}