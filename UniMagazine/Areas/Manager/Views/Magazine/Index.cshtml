@model MagazineFilterVM
@{
    Layout = "/Areas/Manager/Views/_LayoutManagerPage.cshtml";
}

<div class="d-flex flex-row-reverse">
    <a asp-area="Manager" asp-controller="Magazine" asp-action="Add" class="btn btn-dark shadow btn-hover-change" style="background-color: var(--primary-color)">
        <span class="btn-label">
            <i class="fa-solid fa-plus"></i>
        </span>   Add New Magazine
    </a>
    <a asp-area="Manager" asp-controller="Magazine" asp-action="DeadlineIndex" class="btn btn-dark shadow btn-hover-change mx-2" style="background-color: var(--primary-color)">
        <span class="btn-label">
            <i class="fa-solid fa-clock-rotate-left"></i>
        </span>   Assign deadline (@ViewBag.notAssignedNumber)
    </a>
</div>

@* -----Search----- *@
<div class="d-flex justify-content-end text-center shadow mt-2 mb-2 p-2 ml-0 py-3" style="background-color: var(--primary-color)">
    <form asp-action="Index" class="d-flex">
        <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="acaYearId"></label>
            <select class="form-select" id="acaYearId" name="acaYearId">
                <option selected disabled>Academic Years</option>
                @foreach (var acaYear in Model.AcademicYearsDisplay)
                {
                        <option selected="@(acaYear.Id == Model.AcademicYearId)" value="@acaYear.Id">@acaYear.YearDate.ToString("yyyy")</option>
                }
            </select>
        </div>
        <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="status"></label>
            <select class="form-select" id="status" name="status">
                <option selected="@(Model.Status == "")" value="")>Status</option>
                <option selected="@(Model.Status == "Not Started")" value="Not Started">Not Started</option>
                <option selected="@(Model.Status == "Opening")" value="Opening">Opening</option>
                <option selected="@(Model.Status == "Closed")" value="Closed">Closed</option>
            </select>
        </div>

         <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="facultyId"></label>
            <select class="form-select" id="facultyId" name="facultyId">
                <option selected disabled>Faculties</option>
                @foreach (var faculty in Model.FacultiesDisplay)
                {
                        <option selected="@(faculty.Id == Model.FacultyId)" value="@faculty.Id">@faculty.Name</option>
                }
            </select>
        </div>

        <div class="" style="margin-right: 10px">
            <button type="submit" class="btn btn-light">Search</button>
            <a href="/Manager/Magazine/Index" class="btn btn-danger">Clear</a>
        </div>
    </form>
</div>

<div class="d-flex text-center shadow mb-2 mt-3 card-header bg-secondary bg-gradient ml-0 py-3 text-white">
    <div class="container">
        <h1>Magazines - Magazine Mangement</h1>
    </div>
</div>

<div class="container">
    <table class="table table-striped text-center align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th class="text-center">Status</th>
                <th>Posted Date</th>
                <th class="text-center">Deadline</th>
                <th>Faculty</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var magazine in Model.Magazines)
            {
                <tr>
                    <td>@magazine.Id</td>
                    <td>@magazine.Title</td>
                    @if(magazine.Status == "Not Started")
                    {
                        <td>
                            <span class="badge rounded-pill bg-secondary">@magazine.Status</span>
                        </td>
                    }else if (magazine.Status == "Opening"){
                        <td>
                            <span class="badge rounded-pill bg-success">@magazine.Status</span>
                        </td>
                    }
                    else
                    {
                        <td>
                            <span class="badge rounded-pill bg-danger">@magazine.Status</span>
                        </td>
                    }

                    <td>@magazine.PostedDate.ToString("dd/MM/yyyy")</td>
                    @if(magazine.OpenedDate != null){
                        <td class="text-start">
                            <p><span class="badge bg-success me-2">Opened date:</span>@magazine.OpenedDate</p>
                            <p><span class="badge bg-danger me-4" style="margin-right: 1px">Close date:</span>@magazine.ClosedDate</p>
                        </td>
                    }
                    else
                    {
                        <td>This magazine has not had a deadline date yet!</td>
                    }
                    <td>
                        @magazine.Faculty.Name
                    </td>
                    <td style="height: 100px; width: 150px">
                        <img height="100" width="100" src="@magazine.ImageUrl" class="card-img-top object-fit-cover rounded" />
                    </td>
                    <td>
                        <a asp-area="Manager"
                           asp-action="Update"
                           asp-route-id="@magazine.Id" class="btn btn-dark">Detail</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
