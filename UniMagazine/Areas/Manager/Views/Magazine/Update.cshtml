@model MagazineVM
@{
    Layout = "/Areas/Manager/Views/_LayoutManagerPage.cshtml";
}
@if (Model != null){
    <form method="post" enctype="multipart/form-data">
        <h2 class="d-inline-block">Magazine Information
                @if (@Model.Magazine.Status == "Not Started")
                {<span class="badge bg-secondary">@Model.Magazine.Status</span>
                }
                else if (@Model.Magazine.Status == "Opening")
                {<span class="d-inline-block badge bg-success">@Model.Magazine.Status</span>
                }
                else
                {<span class="badge bg-danger">@Model.Magazine.Status</span>
                }</h2>
        <input asp-for="Magazine.Id" hidden />
        <input asp-for="Magazine.ImageUrl" hidden />

        <div class="d-flex">
            @* Bọc trái *@
            <div class="d-flex flex-column flex-fill flex-grow-2 me-5">
                <div class="form-floating mb-3">
                    <input asp-for="@Model.Magazine.Title" class="form-control" autocomplete="title" aria-required="true" placeholder="Magazine Title" />
                    <label asp-for="@Model.Magazine.Title">Title</label>
                    <span asp-validation-for="@Model.Magazine.Title" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <textarea asp-for="@Model.Magazine.Detail" class="form-control" autocomplete="title" aria-required="true" placeholder="Magazine Detail" style="height: 450px"></textarea>
                    <label asp-for="@Model.Magazine.Detail">Detail</label>
                    <span asp-validation-for="@Model.Magazine.Detail" class="text-danger"></span>
                </div>
            </div>

            @* Bọc phải *@
            <div class="flex-grow-0 mx-3" style="width: 400px">
                @if (Model.Magazine.Status != "Closed" && Model.Magazine.Status != "Opening")
                {
                    <div class="mb-3">
                        <label asp-for="Magazine.OpenedDate"> Opened Date</label>
                        <input class="form-control" asp-for="@Model.Magazine.OpenedDate" />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="Magazine.OpenedDate"> Opened Date</label>
                        <input class="form-control" asp-for="@Model.Magazine.OpenedDate"  />
                    </div>
                }
                @* Đưa cái thẻ div ngày đóng vào khu vực này*@
                    <div class="mb-3">
                        <label asp-for="Magazine.ClosedDate"> Close Date</label>
                        <input class="form-control" asp-for="@Model.Magazine.ClosedDate" />
                    </div>
                @* ---end--- *@
                <div class="mb-3">
                    <select asp-for="@Model.Magazine.FacultyId" asp-items="@Model.Faculties" class="form-select">
                        <option value="" disabled selected>Select a faculty</option>
                    </select>
                </div>
                <div class="mb-3">
                    <select asp-for="@Model.Magazine.AcademicYearId" asp-items="@Model.AcademicYears" class="form-select">
                        <option value="" disabled selected>Select an academic year</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Magazine.ImageUrl">Image</label>
                    <input id="imgInp" type="file" name="file" class="form-control" onchange="loadFile(event)" />
                </div>
                <div>
                    <label>Preview Image:</label>
                    <img id="imgOutput" width="100" src="@Model.Magazine.ImageUrl" class="card-img-top rounded" />
                </div>
            </div>
        </div>

        <button type="submit" class="w-100 btn btn-lg btn-secondary mb-3">Update</button>
        <button asp-area="Manager" asp-controller="Magazine" asp-action="Delete" type="submit" class="w-100 btn btn-lg btn-danger mb-3">Delete</button>
    </form>
    <form asp-area="Manager" asp-controller="Magazine" asp-action="Index">
        <button type="submit" class="btn btn-outline-danger" style="width:100%">Cancel</button>
    </form>
}
else
{
    <p>Tag not found!</p>
}

<script>
    const loadFile = () => {
        const output = document.getElementById('imgOutput');
        output.src = URL.createObjectURL(event.target.files[0]);
        output.onload = function () {
            URL.revokeObjectURL(output.src)
        }
    }
</script>