@model IEnumerable<Contribution>

@{
    Layout = "/Areas/Manager/Views/_LayoutManagerPage.cshtml";
    ViewData["Title"] = "Manager page";
    int i = 0;
}
<div class="row">
    <div class="col">
        <div class="row">
            <h5>Contributions number within each Faculty by year</h5>
        </div>
        <div class="row">
            <div class="col-2" hidden>
                <select id="ChartType" class="form-control" style="width:110px;">
                    <option selected>bar</option>
                </select>
            </div>
            <div class="col-3">
                <select id="year" class="form-control" style="width:110px;">
                </select>
            </div>
            <div class="col-4">
                <input id="ID" value="Filter" type="button" />
            </div>

        </div>

        <div id="chartView">
            <canvas id="chart"></canvas>
        </div>
    </div>
    <div class="col">
        <div class="row">
            <h5>Number of contributor in faculty in each year </h5>
        </div>
        <div class="row">
            <div class="col-2" hidden>
                <select id="ChartTypeC" class="form-control" style="width:110px;">
                    <option selected>bar</option>
                </select>
            </div>
            <div class="col-3">
                <select id="yearC" class="form-control" style="width:110px;">
                </select>
            </div>
            <div class="col-4">
                <input id="IDC" value="Filter" type="button" />
            </div>

        </div>
        <div id="chartViewC">
            <canvas id="chartC"></canvas>
        </div>
    </div>
    <div class="col">
        <div class="row">
            <h5>Percentage of contributions within each Faculty by year </h5>
        </div>
        <div class="row">
            <div class="col-2" hidden>
                <select id="ChartTypeP" class="form-control" style="width:110px;">
                    <option selected>pie</option>
                </select>
            </div>
            <div class="col-3">
                <select id="yearP" class="form-control" style="width:110px;">
                </select>
            </div>
            <div class="col-4">
                <input id="IDP" value="Filter" type="button" />
            </div>

        </div>
        <div id="chartViewP">
            <canvas id="chartP"></canvas>
        </div>
    </div>
    
</div>


<br/>
@* Expired Contributions (no feedback comments in 14 days)*@
<h1>
    Contributions without a comment after 14 days
    @if(Model.Count() > 0)
    {
        <span> (@Model.Count() contributions)</span>
    }
</h1>
<div class="card-body p-0">
    <table id="tblData" class="table table-bordered table-striped text-center" style="width:100%">
        <thead class="text-center flex-grow-1">
            <tr>
                <th>Num</th>
                <th>Faculty</th>
                <th>Magazine Topic</th>
                <th>Contribution content</th>
                <th>Submission Date</th>
                <th>Contributor</th>
            </tr>
        </thead>
        <tbody class="text-center align-middle">
            @foreach (var contribution in Model)
            {
                i++;
                <tr>
                    <td>@i</td>
                    <td>@contribution.Magazine.Faculty.Name</td>
                    <td>@contribution.Magazine.Title</td>
                    <td>@contribution.Content</td>
                    <td>@contribution.CreatedDate</td>
                    <td>@contribution.User.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>







<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    $(function () {
        $.ajax({
            type: "GET",
            url: "/Manager/Dash/GetAcademicYears",
            dataType: "json",
            success: function (data) {
                console.log('Data received:', data);
                var select = $('#year');
                var selectP = $('#yearP');
                var selectC = $('#yearC');
                var currentYear = new Date().getFullYear(); // Get the current year
                $.each(data, function (index, item) {
                    var option = $('<option value="' + item.id + '">' + item.text + '</option>');
                    if (item.text === currentYear.toString()) { // Compare item.text with currentYear
                        option.prop('selected', true);
                        console.log(option.val()); // Output the value of the selected option
                        console.log(option.text()); // Output the text of the selected option
                        console.log(currentYear);
                    }
                    select.append(option);
                    selectP.append(option.clone());
                    selectC.append(option.clone());
                    console.log(option.attr('value'));
                    $("#ID").trigger('click');
                    $("#IDP").trigger('click');
                    $("#IDC").trigger('click');
                });
            },
            error: function (xhr, status, error) {
                console.error('Error fetching academic years:', error);
            }
                  
        });
        
        $("#ID").click(function () {
            
            var chartType = $("#ChartType").val();
            var chartView = document.getElementById("chartView");
            var selectedYear = $("#year").val();
            console.log(selectedYear);
            chartView.innerHTML='&nbsp;'
            $('#chartView').append('<canvas id="chart" style="max-width:750pxp;max-height:400px;"></canvas>');

            $.ajax({
                type: "POST",
                url: "/Manager/Dash/AllConInFa",
                data: { year: selectedYear },
                contextType: "application/json; charset=utf-8",
                dataType: "json",
                success: OnSuccessResult,
                error: OnErrorResult    
            });
            

            

            function OnSuccessResult(data) {
                var _data = data;
                var _chartLabel = _data[0];
                var _chartData = _data[1];
                console.log(data);
                var barcolor = ["red", "green", "blue", "orange", "brown", "purple"];

                new Chart("chart",{
                    type:  chartType,
                    data: {
                        labels: _chartLabel,
                        datasets: [{
                            label: "Contribution",
                            data: _chartData
                        }]
                    },
                    options: {
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                })
            }
            function OnErrorResult(data) {

            }
        });
        $("#IDP").click(function () {

            var chartType = $("#ChartTypeP").val();
            var chartView = document.getElementById("chartViewP");
            var selectedYear = $("#yearP").val();
            console.log(selectedYear);
            chartView.innerHTML = '&nbsp;'
            $('#chartViewP').append('<canvas id="chartP" style="max-width:750pxp;max-height:200px;"></canvas>');

            $.ajax({
                type: "POST",
                url: "/Manager/Dash/PercentageByFa",
                data: { year: selectedYear },
                contextType: "application/json; charset=utf-8",
                dataType: "json",
                success: OnSuccessResult,
                error: OnErrorResult
            });




            function OnSuccessResult(data) {
                var _data = data;
                var _chartLabel = _data[0];
                var _chartData = _data[1];
                console.log(data);
                var barcolor = ["red", "green", "blue", "orange", "brown", "purple"];

                new Chart("chartP", {
                    type: chartType,
                    data: {
                        labels: _chartLabel,
                        datasets: [{
                            label: "Contribution in %",
                            data: _chartData 
                        }]
                    },
                    
                    // options: {
                    //     scales: {
                    //         y: {
                    //             beginAtZero: true
                    //         }
                    //     }
                    // }
                })
            }
            function OnErrorResult(data) {

            }
        });
        $("#IDC").click(function () {

            var chartType = $("#ChartTypeC").val();
            var chartView = document.getElementById("chartViewC");
            var selectedYear = $("#yearC").val();
            console.log(selectedYear);
            chartView.innerHTML = '&nbsp;'
            $('#chartViewC').append('<canvas id="chartC" style="max-width:750pxp;max-height:400px;"></canvas>');

            $.ajax({
                type: "POST",
                url: "/Manager/Dash/ContributerInFaAca",
                data: { year: selectedYear },
                contextType: "application/json; charset=utf-8",
                dataType: "json",
                success: OnSuccessResult,
                error: OnErrorResult
            });




            function OnSuccessResult(data) {
                var _data = data;
                var _chartLabel = _data[0];
                var _chartData = _data[1];
                console.log(data);
                

                new Chart("chartC", {
                    type: chartType,
                    data: {
                        labels: _chartLabel,
                        datasets: [{
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(255, 159, 64, 0.2)',
                                'rgba(255, 205, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(201, 203, 207, 0.2)'
                            ],
                            label: "Contributor",
                            data: _chartData
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                    }
                })
            }
            function OnErrorResult(data) {

            }
        });
        
    });
    
        
</script>