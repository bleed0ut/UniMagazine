@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<header class="container pt-4">
    <div class="" role="group" aria-label="Tools">
        <a asp-area="Coordinator" asp-controller="Contribution" asp-action="ContributionModeration" class="btn btn-secondary btn-lg btn-hover-change-jump" style="background-color: var(--primary-color)">
            <span class="btn-label">
                <i class="fa-solid fa-circle-user"></i>
