@model PendingContributionVM
@{
    Layout = "/Areas/Coordinator/Views/_LayoutCoordinatorPage.cshtml";
    ViewData["Title"] = "Admin page";
}

<div class="main-control">
    <form asp-area="Coordinator" asp-controller="Contribution" asp-action="ContributionModeration" class="d-flex w-100 justify-content-between" method="get">
        @* LEFT *@
        <div class="main-control-left">
            <button type="submit" id="status" name="status" value="Pending" class="main-control-text">All pending submission (New submission)</button>
            <button type="submit" id="status" name="status" value="PendingUpdate" class="main-control-text">All pending submission updates</button>
        </div>

        @* RIGHT *@
        <div class="main-control-right">
            <div class="main-control-search">
                <label class="visually-hidden" for="search"></label>
                <div class="main-control-search--input">
                    <input type="text" value="@Model.SearchByTitle" id="searchT" name="searchT" placeholder="Search by magazine's title" class="align-content-lg-start">
                    <input type="text" value="@Model.SearchByContributorEmail" id="searchC" name="searchC" placeholder="Search by contributor's email">
                    <button type="submit" class="search-icon" value="@Model.Status" id="status" name="status">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>
            <div class="search-cancel" style="margin-right: 10px">
                <a href="/Coordinator/Contribution/ContributionModeration">Clear</a>
            </div>
        </div>
    </form>
</div>

@* Show Pending Contribution *@

<div class="row">
    @foreach (var con in Model.Contributions)
    {

        <div class="col-sm-12 col-md-6 col-xl-6 pt-3">
            <a style="text-decoration: none; color: black" asp-area="Coordinator" asp-controller="Contribution" asp-action="GiveFeedback" asp-route-id="@con.Id">
                <div class="stu-contribution-box p-0 shadow">
                    <div class="stu-contribution-box-imgwstatus">
                        <img class="stu-contribution-box-img" src="@con.Magazine.ImageUrl" />
                        <span class="contri-box-status-pending">@con.Status</span>
                    </div>
                    <div class="stu-contribution-box-body justify-content-center p-2">
                        <p class="mb-0"><strong>@con.User.FullName</strong></p>
                        <p class="card-title">(@con.User.Email)</p>
                        <p><strong>Posted date: </strong><i>@con.CreatedDate</i></p>
                        <p class="card-text">@con.Content</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

