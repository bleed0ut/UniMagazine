@model FeedBackVM
<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Add New Contribution</h1>
    </div>
</div>

<div class="container py-5">
    <form method="post" enctype="multipart/form-data">
        <div class="d-flex">
            <div class="mb-3 me-3 flex-grow-1">
                <label class="form-label">Content</label>
                <input type="text" class="form-control" asp-for="@Model.Contribution.Content" readonly />
            </div>
        </div>
        <div class="d-flex">
            <label class="form-label">MagazineId</label>
            <input type="text" class="form-control" asp-for="@Model.Contribution.MagazineId" readonly />
        </div>
        <div class="d-flex">
            <div class="mb-3">
                <label>Image</label>
                <input id="imgInp" type="file" name="files" class="form-control" multiple />
            </div>
        </div>
        <div class="d-flex">
            <div class="mb-3 me-3 flex-grow-1">
                <label class="form-label">Status</label>
                <select class="form-select" asp-for="@Model.Status">
                    <option value="Published">Public</option>
                    <option value="Reject">Reject</option>
                </select>
            </div>
        </div>
        <div class="d-flex">
            <div class="mb-3">
                <label class="form-label" for="comment">Comment</label>
                <textarea class="form-control" id="comment" name="Comment" rows="3" asp-for="@Model.Comment"></textarea>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-dark">Submit</button>
        </div>
    </form>
</div>