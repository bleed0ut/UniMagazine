@model IEnumerable<Faculty>
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}

<div class="d-flex flex-row-reverse">
    <a asp-area="Admin" asp-controller="Faculty" asp-action="Add" class="btn text-white btn-hover-change" style="background-color: var(--secondary-color)">
        <span class="btn-label">
            <i class="fa-solid fa-plus"></i>
        </span>   Add New Faculty
    </a>
</div>
<div class="text-center shadow mt-2 py-3">
    <div class="bg-secondary bg-gradient py-2 text-white text-center">
        <h2>Available faculties - Admin mamangement</h2>
    </div>
    <div class="container p-0">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Desription</th>
                        <th>Created Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
            <tbody class="align-middle">
                    @foreach (var fal in Model)
                    {
                        <tr>
                            <td>@fal.Id</td>
                            <td>@fal.Name</td>
                            <td>@fal.Description</td>
                            <td>@fal.CreateDate</td>
                            <td>
                                <a asp-area="Admin"
                                   asp-action="Update"
                               asp-route-id="@fal.Id" class="btn btn-outline-dark">Detail</a>
                            </td> 
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</div>