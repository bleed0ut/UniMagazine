@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}
<div class="row">
    <div class="col-6">
        <h3>Pie chart</h3>
        <canvas id="pieChart" width="200" height="110" style="width:197px; height:110px"></canvas>
    </div>
    <div class="col-6">
        <h3>Bar chart</h3>
        <canvas id="barChart" width="200" height="110" style="width:197px; height:110px"></canvas>
        <h3>Line chart</h3>
        <canvas id="lineChart" width="200" height="110" style="width:197px; height:110px"></canvas>
    </div>
</div>
<div class="col-6">
    
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $.ajax({
            type: "POST",
            url: "/Admin/Dash/AllConInFa",
            data: "",
            contextType: "application/json; charset=utf8",
            dataType: "json",
            success: function (data) {
                renderBarChart(data);
                renderLineChart(data);
                renderPieChart(data);
            }
        });
        
        function renderBarChart(data) {
            const barChart = document.getElementById('barChart');
            var _data = data;
            var _labels = _data[0];
            var _ChartData = _data[1];
            var colors = ['Red', 'Blue', 'Green', 'Yellow', 'Purple'];

            new Chart(barChart, {
                type: 'bar',
                data: {
                    labels: _labels,
                    datasets: [{
                        backgroundColor: colors,
                        label:'Title',
                        data: _ChartData,
                        borderWidth: 1,
                    }]
                }
            });

        }
        function renderLineChart(data) {
            const lineChart = document.getElementById('lineChart');
            var _data = data; // You can modify this part to get data for the line chart
            var _labels = _data[0]; // Assuming you have labels for the line chart
            var _ChartData = _data[1];

            new Chart(lineChart, {
                type: 'line',
                data: {
                    labels: _labels,
                    datasets: [{
                        label: 'Line Chart',
                        data: _ChartData,
                        borderColor: 'blue',
                        fill: false,
                        tension: 0.1
                    }]
                }
            });
        }
        function renderPieChart(data) {
            const pieChart = document.getElementById('pieChart');
            var _data = data; // You can modify this part to get data for the line chart
            var _labels = _data[0]; // Assuming you have labels for the line chart
            var _ChartData = _data[1];

            new Chart(pieChart, {
                type: 'pie',
                data: {
                    labels: _labels,
                    datasets: [{
                        label: 'pie Chart',
                        data: _ChartData,
                    }]
                }
            });
        }
    });
</script>