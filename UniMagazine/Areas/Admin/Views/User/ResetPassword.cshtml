@model ResetPasswordVM
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
}
<div class="col-9 grid-margin stretch-card" style="margin-left: 200px; margin-top: 100px;">
    <div class="card">
        <div class="card-body">
            <h3 class="text-black text-center">Reset password</h3>
            <label>Email</label>
            <input value="@Model.Email" disabled class="form-control-lg"></input>
            <hr />
            @using (Html.BeginForm("ResetPassword", "User", new { area = "Admin" }, FormMethod.Post))
            {

                <input type="hidden" value="@Model.Email" name="email" />
                <input type="hidden" value="@Model.Code" name="code" />
                <div class="form-outline mb-4">
                    <label class="form-label" for="form2Example27" asp-for="Password">New Password</label>
                    <input type="password" id="form2Example27" asp-for="Password" name="password"
                           class="form-control form-control-lg" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-outline mb-4">
                    <label class="form-label" for="form2Example27" asp-for="ConfirmPassword">Re-password</label>
                    <input type="password" id="form2Example27" asp-for="ConfirmPassword"
                           class="form-control form-control-lg" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-success">Reset</button>
            }

        </div>
        <form asp-area="Admin" asp-controller="User" asp-action="UserIndex" method="get">
            <button type="submit" class="btn btn-outline-danger" style="width:100%">Cancel</button>
        </form>
    </div>
</div>