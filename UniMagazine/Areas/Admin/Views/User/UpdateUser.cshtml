@model UpdateUserModel
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}
<form id="editForm" method="post" enctype="multipart/form-data">
    <h2>Account Information</h2>
    <hr />
    <div class="form-floating mb-3">
        <input asp-for="FullName" class="form-control" autocomplete="fullname" aria-required="true" placeholder="Using real name not nickname" />
        <label asp-for="FullName">Full Name</label>
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" readonly/>
        <label asp-for="Email">Email</label>
    </div>
    <div class="mb-3">
        <h6>Date of birth</h6>
        <input asp-for="DateOfBirth" type="date" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Address" class="form-control" autocomplete="address" aria-required="true" placeholder="Em nha` o? dau the'??" />
        <label asp-for="Address">Address</label>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    
    <div class="mb-3 row">
        <label asp-for="FacultyId">Faculty</label>
        <select asp-for="FacultyId" asp-items="@Model.Faculties">
            <option value="" disabled selected>@Model.FacultyName</option>
        </select>
    </div>
    <div class="mb-3 row">
        <label asp-for="Role">Role</label>
        <select asp-for="Role" asp-items="@Model.Roles">
            <option value="" disabled selected>@Model.Role</option>
        </select>
    </div>

    <button id="editSubmit" type="submit" class="w-100 btn btn-lg btn-secondary mb-3">Update</button>
</form>
<form asp-area="Admin" asp-controller="User" asp-action="UserIndex" method="get">
    <button type="submit" class="btn btn-outline-danger" style="width:100%">Cancel</button>
</form>