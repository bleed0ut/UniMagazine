@model UserVM
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}
@* Search *@
<div class="d-flex flex-row-reverse">
    <a asp-area="Admin" asp-controller="User" asp-action="CreateAccount">
        <p class="btn btn-dark shadow" style="background-color: var(--secondary-color)">
            <i class="fa-solid fa-plus"></i>
            <i class="fa-solid"></i>
            Create a new account
        </p>
    </a>
</div>
<div class="d-flex justify-content-end text-center shadow mt-2 mb-2 p-2 ml-0 py-3" style="background-color: var(--secondary-color)">
    <form asp-action="UserIndex" class="d-flex">
        <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="facultyId"></label>
            <select class="form-select" id="facultyId" name="facultyId">
                <option selected disabled>Faculties</option>
                @foreach (var faculty in Model.Faculties)
                {
                    <option selected="@(faculty.Id == Model.FacultyId)" value="@faculty.Id">@faculty.Name</option>
                }
            </select>
        </div>
        <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="role"></label>
            <select class="form-select" id="role" name="role">
                <option selected="@(Model.Role == "")" value="")>Role</option>
                <option selected="@(Model.Role == "Manager")" value="Manager">Manager</option>
                <option selected="@(Model.Role == "Coordinator")" value="Coordinator">Coordinator</option>
                <option selected="@(Model.Role == "Student")" value="Student">Student</option>
            </select>
        </div>
        
        <div class="" style="margin-right: 10px">
            <label class="visually-hidden" for="search"></label>
            <div class="input-group">
                <div class="input-group-text"></div>
                <input type="text" class="form-control" value="@Model.SearchByEmail" id="search" name="search" placeholder="Search by email">
            </div>
        </div>
        <div class="" style="margin-right: 10px">
            <button type="submit" class="btn btn-light">Search</button>
            <a href="/Admin/User/UserIndex" class="btn btn-danger">Clear</a>
        </div>
    </form>
</div>
<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white">User List</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <table id="tblData" class="table table-bordered table-striped text-center" style="width:100%">
            <thead class="text-center flex-grow-1">
                <tr>
                    <th>Role</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Date of birth</th>
                    <th>Address</th>
                    <th>Falcuty</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (ApplicationUser user in Model.Users){
                    <tr>
                        <td>@user.Role</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.DateOfBirth.ToString("MM/dd/yyyy")</td>
                        <td>@user.Address</td>
                        <td>@user.Faculty.Name</td>
                        <td>
                            <a asp-area="Admin" asp-controller="User" asp-action="UpdateUser" asp-route-id="@user.Id" class="btn btn-outline-dark">
                                Detail
                            </a>
                            <a asp-area="Admin" asp-controller="User" asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-outline-success">
                                Reset password
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


