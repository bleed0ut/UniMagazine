@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<partial name="_Notification" />
<header>
    <div class="" role="group" aria-label="Tools">
        <a asp-area="Admin" asp-controller="User" asp-action="UserIndex" class="btn btn-secondary btn-lg btn-hover-change-jump" style="background-color: var(--primary-color)">
            <span class="btn-label">
                <i class="fa-solid fa-circle-user"></i>
            </span>   Users
        </a>
        <a asp-area="Admin" asp-controller="Faculty" asp-action="List" class="btn btn-secondary btn-lg btn-hover-change-jump" style="background-color: var(--primary-color)">
            <span class="btn-label">
                <i class="fa-brands fa-stack-overflow"></i>
            </span>   Faculties
        </a>
        <a asp-area="Admin" asp-controller="AcademicYear" asp-action="Index" class="btn btn-secondary btn-lg btn-hover-change-jump" style="background-color: var(--primary-color)">
            <span class="btn-label px-1">
                <i class="fa-solid fa-calendar"></i>
            </span>   Academic Years
        </a>
    </div>
    <hr />
</header>
<body>
    <div class="container">
        <main role="main" class="pb-5" >
            @RenderBody()
        </main>
    </div>
    <script src="https://kit.fontawesome.com/c1f40875f2.js" crossorigin="anonymous"></script>
</body>

