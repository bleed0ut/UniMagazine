@model AcademicYear
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}
<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Add New Academic Year - Admin Functionality</h1>
    </div>
</div>

<div class="container py-5">
    <form method="post">
        <div class="d-flex">
            <div class="mb-3 me-3 flex-grow-1">
                <label class="form-label">Open Date</label>
                <input type="date" class="form-control" id="openDate" asp-for="OpenedDate" />
            </div>
            <div class="mb-3 ms-3 flex-grow-1">
                <label class="form-label">Close Date</label>
                <input type="date" class="form-control" id="closeDate" asp-for="ClosedDate" />
            </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-dark">Submit</button>
        </div>
    </form>
</div>
