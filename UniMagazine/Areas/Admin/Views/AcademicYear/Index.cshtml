@model IEnumerable<AcademicYear>
@{
    Layout = "/Areas/Admin/Views/_LayoutAdminPage.cshtml";
    ViewData["Title"] = "Admin page";
}
<div class="d-flex flex-row-reverse">
    <a asp-area="Admin" asp-controller="AcademicYear" asp-action="Add">
        <p class="btn btn-dark shadow btn-hover-change" style="background-color: var(--secondary-color)">
            <i class="fa-solid fa-plus"></i>
            Add New Academic
        </p>   
    </a>
</div>

<div class="card shadow border-0 my-2">
    <div class="card-header bg-secondary bg-gradient ml-0">
        <div class="row">
            <div class="col-12 text-center ">
                <h2 class="text-white">All Academic Year - Admin mamangement</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <table id="tblData" class="table table-bordered table-striped text-center" style="width:100%">
            <thead class="text-center flex-grow-1">
                <tr>
                    <th>Id</th>
                    <th>Academic Year Date</th>
                    <th>Open Date</th>
                    <th>Close Date</th>
                    <th>Sattus</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var academic in Model)
                {
                    <tr>
                        <td>@academic.Id</td>
                        <td>@academic.YearDate.ToString("yyyy")</td>
                        <td>@academic.OpenedDate</td>
                        <td>@academic.ClosedDate</td>
                        <td>@academic.Status</td>
                        <td>
                            <a asp-area="Admin"
                               asp-action="Update"
                               asp-route-id="@academic.Id" class="btn btn-outline-dark">Detail</a>
                            <a asp-area="Admin" asp-controller="AcademicYear" asp-action="DownloadFilesByAcademicYear" asp-route-academicYearId="@academic.Id" class="btn btn-success">Download Contributions</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>